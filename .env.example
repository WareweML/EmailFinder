# Copy to .env — never commit real values.

# LinkedIn Voyager (li_at + JSESSIONID ajax:...)
LI_AT=
LI_JSESSIONID=

# CaptchaAI (Hunter trial Turnstile)
CAPTCHAAI_KEY=

# Decodo Fast Search — header value including "Basic "
DECODO_BASIC_AUTH=

# OkkProxy config URLs
OKK_PROXY_CONFIG_URL=
OKK_PROXY_CONFIG_URL_BING=
OKK_STICKY_MINUTES=30

# Optional credit APIs
HUNTER_API_KEY=
PDL_API_KEY=
THEORG_API_KEY=
