# Copy to .env — never commit real values.

# ApiAlt LinkedIn API (https://apialt.com/docs). When set, personal cookies are never sent.
APIALT_KEY=

# Personal LinkedIn / Sales Nav — cookies live in data/li-session.json
# ALL authenticated LinkedIn traffic MUST use this SOCKS5 pin (host:port:user:pass).
# If this is empty, cookies are never sent (fail closed). Ignored when APIALT_KEY is set.
LI_USE_SESSION=0
LI_SOCKS_PROXY=
LI_AT=
LI_JSESSIONID=
LI_A=

# CaptchaAI (Hunter trial Turnstile)
CAPTCHAAI_KEY=

# Decodo Fast Search — header value including "Basic "
DECODO_BASIC_AUTH=

# RocketReach left unused unless you drop a Pro key
ROCKETREACH_API_KEY=
ROCKETREACH_PLAN=pro

OKK_STICKY_MINUTES=30
# host:port:user:pass — td-customer-…-sessid-…-sesstime-N
# OKK is NEVER used for the personal LinkedIn cookie.
OKK_PROXY=

# Optional credit APIs
HUNTER_API_KEY=
PDL_API_KEY=
THEORG_API_KEY=
PROSPEO_API_KEY=
APOLLO_API_KEY=
DATAGMA_API_ID=
ENROW_API_KEY=

# Have I Been Pwned — official API key (haveibeenpwned.com/API/Key).
