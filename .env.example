# Copy to .env — never commit real values.

# LinkedIn Voyager (li_at + JSESSIONID ajax:...)
LI_AT=
LI_JSESSIONID=

# CaptchaAI (Hunter trial Turnstile)
CAPTCHAAI_KEY=

# Decodo Fast Search — header value including "Basic "
DECODO_BASIC_AUTH=

# RocketReach left unused unless you drop a Pro key
ROCKETREACH_API_KEY=
ROCKETREACH_PLAN=pro

OKK_STICKY_MINUTES=30
# host:port:user:pass — td-customer-…-sessid-…-sesstime-N
OKK_PROXY=

# Optional credit APIs
HUNTER_API_KEY=
PDL_API_KEY=
THEORG_API_KEY=
PROSPEO_API_KEY=
APOLLO_API_KEY=
DATAGMA_API_ID=
ENROW_API_KEY=

# Have I Been Pwned — official API key (haveibeenpwned.com/API/Key).
# Checks emails/phones you already have against breach *names*. Never returns dump rows or stolen numbers.
HIBP_API_KEY=

# WhatsApp existence check — liveness tag on a number we already found. Not a last-4 brute.
# Pick one: Whapi (5-day free channel) | GREEN-API | generic (whatsabot / checkleaked / opendata)
WHAPI_TOKEN=
GREENAPI_ID=
GREENAPI_TOKEN=
WHATSAPP_CHECK_URL=
WHATSAPP_CHECK_KEY=
